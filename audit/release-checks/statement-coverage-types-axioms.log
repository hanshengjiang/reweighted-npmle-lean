@ReweightedNPMLE.compactGaussianMixture_population_gap_eq_klDiv : ∀ {d : ℕ} {K : Set (ReweightedNPMLE.Point d)}
  (Gstar G : MeasureTheory.ProbabilityMeasure ↑K) {S : ℝ},
  0 ≤ S →
    (∀ a ∈ K, ‖a‖ ≤ S) →
      MeasureTheory.Integrable
          (fun (x : ReweightedNPMLE.Point d) => Real.log (ReweightedNPMLE.compactGaussianMixtureDensity G x))
          (ReweightedNPMLE.gaussianLocationMixtureLaw ↑Gstar fun (a : ↑K) => ↑a) →
        have ρ := ReweightedNPMLE.gaussianLocationMixtureLaw ↑Gstar fun (a : ↑K) => ↑a;
        have σ := ReweightedNPMLE.gaussianLocationMixtureLaw ↑G fun (a : ↑K) => ↑a;
        have gap :=
          ∫ (x : ReweightedNPMLE.Point d), Real.log (ReweightedNPMLE.compactGaussianMixtureDensity Gstar x) ∂ρ -
            ∫ (x : ReweightedNPMLE.Point d), Real.log (ReweightedNPMLE.compactGaussianMixtureDensity G x) ∂ρ;
        gap = (InformationTheory.klDiv ρ σ).toReal ∧ 0 ≤ gap ∧ (gap = 0 ↔ ρ = σ)
