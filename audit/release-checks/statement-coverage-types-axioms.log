              have t := ReweightedNPMLE.fittedLogDisplacement C hCcompact hCnonempty hCpos z₀ w;
              (∀ (i : Fin n), |t i| < 1 / 8) ∧
                0 ≤ ∑ i : Fin n, (w i - 1) * t i ∧
