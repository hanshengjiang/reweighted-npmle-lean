@ReweightedNPMLE.paper_radial_localization : ∀ {n : ℕ} [Nonempty (Fin n)] {C : Set (Fin n → ℝ)},
  Convex ℝ C →
    C ⊆ ReweightedNPMLE.positiveVectors n →
      ∀ (v₀ : Fin n → ℝ),
        ReweightedNPMLE.IsMaxOn C (ReweightedNPMLE.weightedLogLikelihood 1) v₀ →
          ∀ (V : Submodule ℝ (EuclideanSpace ℝ (Fin n))) {η : ℝ},
            0 ≤ η →
              (∀ u ∈ ReweightedNPMLE.relativeFittedSet C v₀,
                  ‖WithLp.toLp 2 u - V.starProjection (WithLp.toLp 2 u)‖ ≤ η) →
                ∀ {w : Fin n → ℝ},
                  w ∈ ReweightedNPMLE.paperRadialEvent V η →
                    ∀ {v : Fin n → ℝ},
                      v ∈ C →
                        ∀ {τ : ℝ},
                          0 ≤ τ →
                            τ < (1 / 16) ^ 2 / 12 →
                              ReweightedNPMLE.weightedLogLikelihood w v₀ - τ ≤
                                  ReweightedNPMLE.weightedLogLikelihood w v →
                                have u := ReweightedNPMLE.relativeFittedVector v₀ v;
                                have A := ‖V.starProjection (WithLp.toLp 2 fun (i : Fin n) => w i - 1)‖;
                                have E := η * ‖WithLp.toLp 2 fun (i : Fin n) => w i - 1‖;
                                √(∑ i : Fin n, u i ^ 2) < 1 / 16 ∧
                                  ∑ i : Fin n, u i ^ 2 ≤ 36 * A ^ 2 + 12 * E + 12 * τ ∧
                                    (∀ (i : Fin n), |ReweightedNPMLE.fittedLogRatio v₀ v i| < 1 / 8) ∧
                                      0 ≤
                                          ReweightedNPMLE.weightedLogLikelihood 1 v₀ -
                                            ReweightedNPMLE.weightedLogLikelihood 1 v ∧
                                        ReweightedNPMLE.weightedLogLikelihood 1 v₀ -
                                              ReweightedNPMLE.weightedLogLikelihood 1 v ≤
                                            37 * A ^ 2 + 13 * E + 13 * τ ∧
                                          ∑ i : Fin n, ReweightedNPMLE.fittedLogRatio v₀ v i ^ 2 ≤
                                              72 * A ^ 2 + 24 * E + 24 * τ ∧
                                            ∑ i : Fin n, (w i - 1) * ReweightedNPMLE.fittedLogRatio v₀ v i ≤
                                              37 * A ^ 2 + 13 * E + 12 * τ
@ReweightedNPMLE.canonical_paper_radial_exact_fit : ∀ {n : ℕ} [Nonempty (Fin n)] (C : Set (Fin n → ℝ)),
