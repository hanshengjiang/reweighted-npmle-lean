@ReweightedNPMLE.gaussian_conditional_structural_and_likelihood_bounds : ∀ {Θ : Type u_1} [inst : MetricSpace Θ]
  [inst_1 : CompactSpace Θ] [inst_2 : Nonempty Θ] [inst_3 : MeasurableSpace Θ] [inst_4 : BorelSpace Θ] {d : ℕ},
