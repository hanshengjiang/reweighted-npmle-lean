ReweightedNPMLE.gaussian_generic_optimizer_fiber_uniqueness : ∀ (n d : ℕ) [Nonempty (Fin n)],
  ∃ (X : Set (Fin n → ReweightedNPMLE.Point d)),
    MeasurableSet X ∧
      MeasureTheory.volume Xᶜ = 0 ∧
        ∀ x ∈ X,
          ∀ (Θ : Type) [inst : MetricSpace Θ] [CompactSpace Θ] [inst_2 : MeasurableSpace Θ] [BorelSpace Θ]
            (θ : Θ → ReweightedNPMLE.Point d),
            Continuous θ →
              Function.Injective θ →
                ∀ (m : ℕ) (w v : Fin n → ℝ),
                  w ∈ ReweightedNPMLE.positiveVectors n →
                    ReweightedNPMLE.IsMaxOn
                        ((convexHull ℝ) (Set.range fun (a : Θ) => ReweightedNPMLE.gaussianScoreFeature x (θ a)))
                        (ReweightedNPMLE.weightedLogLikelihood w) v →
                      2 * m * (d + 1) ≤ n →
                        (∀ (μ : MeasureTheory.ProbabilityMeasure Θ),
                            ReweightedNPMLE.IsExtremeProbabilityMixture
                                (fun (a : Θ) => ReweightedNPMLE.gaussianScoreFeature x (θ a)) v μ →
                              (↑μ).support.ncard ≤ m) →
                          ∃ (μ : MeasureTheory.ProbabilityMeasure Θ),
                            ReweightedNPMLE.probabilityMixtureFiber
                                  (fun (a : Θ) (i : Fin n) => ReweightedNPMLE.gaussianKernel d (x i) (θ a))
