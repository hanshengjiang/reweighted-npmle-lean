@ReweightedNPMLE.effective_dimension_full_support : ∀ {Θ : Type u_1} [inst : MetricSpace Θ] [inst_1 : CompactSpace Θ]
  [inst_2 : Nonempty Θ] [inst_3 : MeasurableSpace Θ] [BorelSpace Θ] {n r : ℕ} [Nonempty (Fin n)] {α q η : ℝ},
  1 ≤ q →
    0 ≤ η →
      10000000 * (↑r + ReweightedNPMLE.effectiveQ n q) ≤ α →
        η * √(α * ↑n * ReweightedNPMLE.effectiveQ n q) ≤ 1 →
          ∀ (A : Θ → Fin n → ℝ) (hA : Continuous A) (hApos : ∀ (θ : Θ) (i : Fin n), 0 < A θ i)
            (V : Submodule ℝ (EuclideanSpace ℝ (Fin n))),
            Module.finrank ℝ ↥V ≤ r →
              (∀
                  u ∈
                    ReweightedNPMLE.relativeFittedSet ((convexHull ℝ) (Set.range A))
                      (ReweightedNPMLE.fittedValueSelection ((convexHull ℝ) (Set.range A)) ⋯ ⋯ ⋯ 1),
                  ‖WithLp.toLp 2 u - V.starProjection (WithLp.toLp 2 u)‖ ≤ η) →
                let C := (convexHull ℝ) (Set.range A);
                have vhat := ReweightedNPMLE.fittedValueSelection C ⋯ ⋯ ⋯;
                have v₀ := vhat 1;
                Measurable (ReweightedNPMLE.maximumExtremeSupport A vhat) ∧
                  ∃ (G : Set (Fin n → ℝ)),
                    MeasurableSet G ∧
                      (ReweightedNPMLE.gammaProductMeasure n α α).real Gᶜ ≤ 3 * Real.exp (-q) ∧
                        ∀ w ∈ G,
                          (∀ (i : Fin n), |w i - 1| ≤ 2 * √(ReweightedNPMLE.effectiveQ n q / α)) ∧
                            w ∈ ReweightedNPMLE.positiveVectors n ∧
                              ↑(ReweightedNPMLE.maximumExtremeSupport A vhat w) ≤ 10000000 * (↑r + q) ∧
                                (0 < ReweightedNPMLE.maximumExtremeSupport A vhat w ∧
                                    ReweightedNPMLE.maximumExtremeSupport A vhat w ≤ n ∧
                                      ∃ (μ : MeasureTheory.ProbabilityMeasure Θ),
                                        ReweightedNPMLE.IsExtremeProbabilityMixture A (vhat w) μ ∧
                                          (↑μ).support.ncard = ReweightedNPMLE.maximumExtremeSupport A vhat w) ∧
                                  (∀ (μ : MeasureTheory.ProbabilityMeasure Θ),
                                      ReweightedNPMLE.IsExtremeProbabilityMixture A (vhat w) μ →
                                        (↑μ).support.Finite ∧ ↑(↑μ).support.ncard ≤ 10000000 * (↑r + q)) ∧
                                    0 ≤
                                        ReweightedNPMLE.weightedLogLikelihood 1 v₀ -
                                          ReweightedNPMLE.weightedLogLikelihood 1 (vhat w) ∧
                                      ReweightedNPMLE.weightedLogLikelihood 1 v₀ -
                                            ReweightedNPMLE.weightedLogLikelihood 1 (vhat w) ≤
                                          10000000 * (↑r + q) / α ∧
                                        ∑ i : Fin n, ReweightedNPMLE.fittedLogRatio v₀ (vhat w) i ^ 2 ≤
                                            10000000 * (↑r + q) / α ∧
                                          ∀ (τ : ℝ),
                                            0 ≤ τ →
                                              τ < 1 / 3072 →
                                                ∀ v ∈ C,
                                                  ReweightedNPMLE.weightedLogLikelihood w (vhat w) - τ ≤
                                                      ReweightedNPMLE.weightedLogLikelihood w v →
                                                    0 ≤
                                                        ReweightedNPMLE.weightedLogLikelihood 1 v₀ -
                                                          ReweightedNPMLE.weightedLogLikelihood 1 v ∧
                                                      ReweightedNPMLE.weightedLogLikelihood 1 v₀ -
                                                            ReweightedNPMLE.weightedLogLikelihood 1 v ≤
                                                          10000000 * ((↑r + q) / α + τ) ∧
                                                        ∑ i : Fin n, ReweightedNPMLE.fittedLogRatio v₀ v i ^ 2 ≤
                                                          10000000 * ((↑r + q) / α + τ)
@ReweightedNPMLE.full_support_sensitivity_ae : ∀ {Θ : Type u_1} [inst : MetricSpace Θ] [CompactSpace Θ]
  [inst_2 : MeasurableSpace Θ] [BorelSpace Θ] {n : ℕ} [Nonempty (Fin n)] (A : Θ → Fin n → ℝ),
  Continuous A →
    ∀ (C : Set (Fin n → ℝ)),
      Convex ℝ C →
        ∀ (hCcompact : IsCompact C) (hCnonempty : C.Nonempty) (hCpos : C ⊆ ReweightedNPMLE.positiveVectors n),
          Set.range A ⊆ C →
            C ⊆ (convexHull ℝ) (Set.range A) →
              have vhat := ReweightedNPMLE.fittedValueSelection C hCcompact hCnonempty hCpos;
              have z := ReweightedNPMLE.fittedLogSelection C hCcompact hCnonempty hCpos;
              ∀ᵐ (w : Fin n → ℝ),
                w ∈ ReweightedNPMLE.positiveVectors n →
                  have J := fderiv ℝ z w;
                  have H := ReweightedNPMLE.fittedLogDerivativeMatrix J;
                  have D := Matrix.diagonal fun (i : Fin n) => √(w i);
                  HasFDerivAt (fderiv ℝ (ReweightedNPMLE.fittedOptimalValue vhat))
                      (ReweightedNPMLE.fittedSecondDerivativeOfLogDerivative J) w ∧
                    (∀ (μ : MeasureTheory.ProbabilityMeasure Θ),
                        ReweightedNPMLE.IsExtremeProbabilityMixture A (vhat w) μ →
                          ∃ (P : Matrix (Fin n) (Fin n) ℝ),
                            P.IsHermitian ∧ P * P = P ∧ P.rank = (↑μ).support.ncard - 1 ∧ (D * H * D - P).PosSemidef) ∧
                      ∃ (P : Matrix (Fin n) (Fin n) ℝ),
                        P.IsHermitian ∧
                          P * P = P ∧
                            P.rank = ReweightedNPMLE.maximumExtremeSupport A vhat w - 1 ∧ (D * H * D - P).PosSemidef
@ReweightedNPMLE.gaussian_probability_relative_width_bound : ∀ {Θ : Type u_1} [inst : MetricSpace Θ] [CompactSpace Θ]
  [Nonempty Θ] [inst_3 : MeasurableSpace Θ] [BorelSpace Θ] {d n : ℕ} (L : ℕ) (x : Fin n → ReweightedNPMLE.Point d)
  (θ : Θ → ReweightedNPMLE.Point d),
